<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>F-7WHISPER</AssemblyName>
    <RootNamespace>F7Whisper</RootNamespace>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);src-tauri\**;blur-engine\**;node_modules\**;.github\**</DefaultItemExcludes>
    <!-- Blur AutoClicker's engine (Rust cdylib), loaded through DllImport("blur_engine"). -->
    <BlurEngineDir>$(MSBuildProjectDirectory)\blur-engine</BlurEngineDir>
    <BlurEngineDll Condition="'$(BlurEngineDll)' == ''">$(BlurEngineDir)\target\release\blur_engine.dll</BlurEngineDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="assets\app.ico" LogicalName="F7Whisper.app.ico" />
    <None Update="ui\**\*"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    blur_engine.dll goes beside the exe on build and into the publish set. A single-file
    publish with IncludeNativeLibrariesForSelfExtract=true bundles it inside the exe; at
    start-up the host extracts bundled native libraries and adds that folder to the
    native search path, so DllImport("blur_engine") finds it.
    With SkipBlurEngineBuild=true the DLL is only included if it already exists.
  -->
  <ItemGroup Condition="'$(SkipBlurEngineBuild)' != 'true' Or Exists('$(BlurEngineDll)')">
    <None Include="$(BlurEngineDll)"
          Link="blur_engine.dll"
          Visible="false"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildBlurEngine" BeforeTargets="BeforeBuild"
          Condition="'$(SkipBlurEngineBuild)' != 'true'">
    <Exec Command="cargo build --release --manifest-path &quot;$(BlurEngineDir)\Cargo.toml&quot;" />
  </Target>
</Project>
